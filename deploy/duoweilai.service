[Unit]
Description=Duoweilai Web (v0.6)
After=network.target

[Service]
Type=simple
User=duoweilai
Group=duoweilai
WorkingDirectory=/opt/duoweilai
Environment=DUOWEILAI_BIND=127.0.0.1
Environment=DUOWEILAI_PORT=8090
Environment=DUOWEILAI_SECURE_COOKIE=1
# 随机 session 密钥由 setup.sh 生成（重复部署不覆盖，避免所有人掉线）
EnvironmentFile=/opt/duoweilai/secret.env
ExecStart=/opt/duoweilai/venv/bin/gunicorn -w 4 -b 127.0.0.1:8090 "app:create_app()"
Restart=always
RestartSec=3

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/duoweilai

[Install]
WantedBy=multi-user.target
