[Unit]
Description=Duoweilai Web (v0.3)
After=network.target

[Service]
Type=simple
User=duoweilai
Group=duoweilai
WorkingDirectory=/opt/duoweilai
Environment=DUOWEILAI_BIND=127.0.0.1
Environment=DUOWEILAI_PORT=8090
Environment=DUOWEILAI_SECURE_COOKIE=1
ExecStart=/usr/bin/python3 /opt/duoweilai/server.py
Restart=always
RestartSec=3

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/duoweilai

[Install]
WantedBy=multi-user.target
